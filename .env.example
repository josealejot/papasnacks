# Nombre del negocio y datos para facturas PDF
APP_NAME='Inversiones "El Profeta" - Gestión Comercial y Control de Capital'
BUSINESS_NAME='INVERSIONES "EL PROFETA"'
BUSINESS_NIT="1020233725"
BUSINESS_PHONE="3024645363"
